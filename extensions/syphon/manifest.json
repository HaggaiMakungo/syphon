{
  "manifest_version": 3,
  "name": "Syphon this",
  "version": "0.7.4",
  "description": "Hand a download link to the Syphon desktop app.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "optional_permissions": [
    "cookies",
    "downloads",
    "scripting",
    "webRequest"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Syphon this",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "brand/icon-16.png",
      "32": "brand/icon-32.png",
      "48": "brand/icon-48.png",
      "64": "brand/icon-64.png",
      "128": "brand/icon-128.png"
    }
  },
  "icons": {
    "16": "brand/icon-16.png",
    "32": "brand/icon-32.png",
    "48": "brand/icon-48.png",
    "64": "brand/icon-64.png",
    "128": "brand/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "brand/icon-64.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
