<Window x:Class="Syphon.Setup.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Syphon Setup" Width="650" Height="600" MinWidth="590" MinHeight="0" SizeToContent="Height" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" FontSize="13">
 <Border CornerRadius="32" BorderBrush="#5B4664" BorderThickness="1" Background="#121014" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Grid.Row="0" CornerRadius="32,32,0,0" Background="#201A24" BorderBrush="#33283B" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader"><Grid Margin="18,0,12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Brand/emblem.png" Width="23" Height="25" Margin="0,0,10,0"/><TextBlock Text="Syphon" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="WindowCaption" Text="Setup" FontSize="11" Foreground="#AA92B6" Margin="13,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Content="×" HorizontalAlignment="Right" Width="30" Height="30" Padding="0" FontSize="23" Background="Transparent" BorderThickness="0" Click="CancelClick" ToolTip="Close setup" AutomationProperties.Name="Close setup"/></Grid></Border>
 <ScrollViewer x:Name="SetupBody" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,27,28,18"><StackPanel><Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition Width="73"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="56" Height="60" CornerRadius="19" Background="#3D2649" BorderBrush="#674079" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"><Image Source="Brand/emblem.png" Width="36" Height="36"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="Heading" Text="Welcome to Syphon" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="Set up your download workspace." Foreground="#B49AC2" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid><WrapPanel x:Name="Steps" Margin="0,0,0,22"><Border x:Name="Step0" CornerRadius="12" Padding="10,8" BorderThickness="1" Margin="0,0,5,6"><TextBlock Text="1  Welcome" FontSize="10"/></Border><Border x:Name="Step1" CornerRadius="12" Padding="10,8" BorderThickness="1" Margin="0,0,5,6"><TextBlock Text="2  Location" FontSize="10"/></Border><Border x:Name="Step2" CornerRadius="12" Padding="10,8" BorderThickness="1" Margin="0,0,5,6"><TextBlock Text="3  Install" FontSize="10"/></Border><Border x:Name="Step3" CornerRadius="12" Padding="10,8" BorderThickness="1" Margin="0,0,5,6"><TextBlock Text="4  Browser" FontSize="10"/></Border><Border x:Name="Step4" CornerRadius="12" Padding="10,8" BorderThickness="1" Margin="0,0,5,6"><TextBlock Text="5  Finish" FontSize="10"/></Border></WrapPanel><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=MaintenancePanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="MaintenancePanel" Visibility="Collapsed">
        <TextBlock Text="Choose an installed copy" FontWeight="SemiBold" Margin="0,0,0,10" />
        <ListBox x:Name="InstallationList" Background="#17131C" Foreground="#ECE9F2" BorderBrush="#4C395F" BorderThickness="1" Padding="6" MaxHeight="115" SelectionChanged="InstallationChanged" AutomationProperties.Name="Installed Syphon copies">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="3"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#392A4E" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#D49AF0" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5"><TextBlock Text="{Binding Version}" FontWeight="SemiBold" /><TextBlock Text="{Binding Root}" Foreground="#B9A8C3" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="MaintenanceNote" Foreground="#B9A8C3" Margin="0,15,0,16" />
        <WrapPanel><Button x:Name="RepairButton" Content="Repair installation" Click="RepairClick" Margin="0,0,10,8" /><Button Content="Uninstall Syphon" Click="MaintenanceUninstallClick" Margin="0,0,0,8" /></WrapPanel>
        <TextBlock Text="Continue below to upgrade or reinstall using this package. Repair restores packaged files and integration choices. Your downloads, history and preferences stay." Foreground="#9D89AC" FontSize="12" Margin="0,12,0,0" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=CleanupPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="CleanupPanel" Visibility="Collapsed" Margin="0,22,0,0">
        <TextBlock Text="Broken setup entries found" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock x:Name="CleanupSummary" Foreground="#B9A8C3" FontSize="12" Margin="0,0,0,12" />
        <Button x:Name="CleanupButton" Content="Clean up broken setup entries" Click="CleanupClick" HorizontalAlignment="Left" />
        <TextBlock x:Name="CleanupResult" Foreground="#B9A8C3" FontSize="12" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=WelcomePanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WelcomePanel">
        <Grid Margin="0,0,0,27"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border BorderBrush="#9D64E5" BorderThickness="1" CornerRadius="16" Width="51" Height="51" HorizontalAlignment="Left"><TextBlock Text="↓" FontSize="14" Foreground="#D49AF0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Resumable downloads" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Pause and continue when the source supports resume." Foreground="#B9A8C3" Margin="0,6,0,0" /></StackPanel></Grid>
        <Grid Margin="0,0,0,27"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border BorderBrush="#9D64E5" BorderThickness="1" CornerRadius="16" Width="51" Height="51" HorizontalAlignment="Left"><TextBlock Text="▤" FontSize="14" Foreground="#D49AF0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="Browser integration" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Send links from your browser with the Syphon extension." Foreground="#B9A8C3" Margin="0,6,0,0" /></StackPanel></Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border BorderBrush="#9D64E5" BorderThickness="1" CornerRadius="16" Width="51" Height="51" HorizontalAlignment="Left"><TextBlock Text="✓" FontSize="14" Foreground="#D49AF0" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="File integrity tools" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Recorded SHA-256 checksums and optional publisher verification." Foreground="#B9A8C3" Margin="0,6,0,0" /></StackPanel></Grid>
        <TextBlock Text="Includes FFmpeg, FFprobe, yt-dlp, Node.js and .NET. Internet is needed only if the Microsoft WebView2 runtime is missing." Foreground="#9D89AC" FontSize="12" Margin="0,28,0,0" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=LocationPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LocationPanel" Visibility="Collapsed">
        <TextBlock Text="Install Syphon for all users on this computer" FontWeight="SemiBold" Margin="0,0,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="Location" AutomationProperties.Name="Installation folder" /><Button x:Name="BrowseLocation" Grid.Column="1" Content="Browse…" Click="BrowseClick" Margin="10,0,0,0" Padding="12,8" /></Grid>
        <TextBlock x:Name="SizeNote" Foreground="#9D89AC" Margin="0,9,0,18" Text="Setup checks the available space before installing." />
        <TextBlock x:Name="BrowserReviewNote" Text="Browser setup follows installation. You can connect your browser or explicitly continue without integration." Foreground="#B9A8C3" Margin="0,12" /><CheckBox x:Name="DesktopOption" IsChecked="True" Content="Create a desktop shortcut" />
        <TextBlock Text="Your existing downloads, history and preferences are preserved. New downloads use Videos, Music, Documents, Programs and Misc folders." Foreground="#B9A8C3" Margin="0,20,0,10" />
        <TextBlock Text="Browser extension installation still requires your approval inside Chrome or Edge. Bundled tool licences and release notes are included in the installation folder." Foreground="#9D89AC" FontSize="12" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=InstallPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="InstallPanel" Visibility="Collapsed"><TextBlock x:Name="Status" Text="Preparing installation…" FontSize="16" Margin="0,12,0,20" AutomationProperties.LiveSetting="Polite" /><ProgressBar x:Name="Progress" Height="9" Minimum="0" Maximum="100" Foreground="#AB72EF" Background="#1A1324" BorderThickness="0" /><TextBlock x:Name="Percent" Text="0%" Foreground="#B9A8C3" HorizontalAlignment="Right" Margin="0,12" /><TextBlock Text="Files are checked before they replace an existing installation. Setup will never close an active Syphon download for you." Foreground="#9D89AC" Margin="0,24" /></StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=UninstallPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="UninstallPanel" Visibility="Collapsed">
        <TextBlock Text="This will remove:" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="• Syphon application files and bundled media tools&#10;• Syphon shortcuts and its owned browser connection" Margin="0,0,0,24" />
        <TextBlock Text="Your files stay safe" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock Text="Downloaded files, history and personal settings will be kept. The browser extension can be removed separately in Chrome or Edge." Foreground="#B9A8C3" Margin="0,0,0,20" />
        <TextBlock Text="Close Syphon before continuing. Any active downloads must finish or be paused first." Foreground="#9D89AC" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=BrowserPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="BrowserPanel" Visibility="Collapsed">
        <TextBlock Text="1. Open chrome://extensions or edge://extensions in your browser." Margin="0,0,0,8" />
        <TextBlock Text="2. Enable Developer mode, choose Load unpacked and select the Extensions folder shown below." Margin="0,0,0,8" />
        <TextBlock Text="3. Continue below, then open the Syphon extension and choose Check connection. Refresh existing video tabs." Margin="0,0,0,14" />
        <TextBox x:Name="ExtensionPath" IsReadOnly="True" AutomationProperties.Name="Extensions folder path" />
        <WrapPanel Margin="0,12,0,10"><Button Content="Open Extensions folder" Click="OpenExtensionsClick" Margin="0,0,10,8" /><Button Content="Copy folder path" Click="CopyExtensionsClick" Margin="0,0,0,8" /></WrapPanel>
        <TextBlock Text="A README is included inside Extensions. Store installation will be available once the extension is published." Foreground="#9D89AC" FontSize="12" Margin="0,0,0,12" />
        <RadioButton x:Name="ReadyBrowser" GroupName="BrowserChoice" Content="I've added the extension, or will finish connecting it later." Foreground="#ECE9F2" Margin="0,6" Checked="BrowserChoiceChanged" />
        <RadioButton x:Name="SkipBrowser" GroupName="BrowserChoice" Content="Use Syphon without the browser extension." Foreground="#B9A8C3" Margin="0,6" Checked="BrowserChoiceChanged" />
       </StackPanel>
       </Border><Border Background="#211B27" BorderBrush="#3A2B43" BorderThickness="1" CornerRadius="22" Padding="20" Margin="0,0,0,14" Visibility="{Binding Visibility,ElementName=FinishPanel}"><StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="FinishPanel" Visibility="Collapsed"><TextBlock x:Name="FinishNote" Text="Your download workspace is ready." Foreground="#B9A8C3" FontSize="16" /><Button x:Name="OpenSyphon" Content="Open Syphon" Click="OpenSyphonClick" HorizontalAlignment="Left" Margin="0,24,0,8" /><Button x:Name="ExtensionHelp" Content="Review browser instructions" Click="ExtensionClick" HorizontalAlignment="Left" Margin="0,14,0,0" /><TextBlock x:Name="FinishPath" Foreground="#9D89AC" Margin="0,22,0,0" FontSize="12" /></StackPanel>
      </Border><TextBlock x:Name="Error" Visibility="Collapsed" Foreground="#EEB3BE" Margin="0,8,0,12" AutomationProperties.LiveSetting="Assertive"/><TextBlock x:Name="VersionLabel" Text="Windows x64" Foreground="#937FA1" FontSize="10" Margin="0,8,0,0"/></StackPanel></ScrollViewer>
 <Border Grid.Row="2" BorderBrush="#33273D" BorderThickness="0,1,0,0" CornerRadius="0,0,32,32" Background="#1B171F" Padding="23,19"><Grid><Button x:Name="Back" Content="Back" HorizontalAlignment="Left" Visibility="Collapsed" Click="BackClick"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" MinWidth="90" Click="CancelClick" Margin="0,0,10,0"/><Button x:Name="Next" Content="Continue" MinWidth="130" BorderBrush="#D28CEC" Click="NextClick"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#AE56D0"/><GradientStop Color="#8129AC" Offset="1"/></LinearGradientBrush></Button.Background></Button></StackPanel></Grid></Border>
 </Grid></Border></Window>