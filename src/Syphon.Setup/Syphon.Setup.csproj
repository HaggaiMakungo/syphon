<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
  <EnableSetupDiagnostics Condition="'$(EnableSetupDiagnostics)' == ''">false</EnableSetupDiagnostics>
  <DefineConstants Condition="'$(EnableSetupDiagnostics)' == 'true'">$(DefineConstants);SETUP_DIAGNOSTICS</DefineConstants>
  <ApplicationManifest>app.manifest</ApplicationManifest>
  <AssemblyName>Syphon.Setup</AssemblyName><Version>0.1.0-beta.20</Version><ApplicationIcon>../Syphon.Desktop/Assets/Brand/syphon_windows.ico</ApplicationIcon>
  <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile><PublishTrimmed>false</PublishTrimmed>
  <NoWarn>$(NoWarn);IL3000</NoWarn>
 </PropertyGroup>
 <ItemGroup Condition="'$(EnableSetupDiagnostics)' != 'true'"><Compile Remove="SetupTests.cs;SetupMaintenanceTests.cs;SetupProductionTests.cs"/></ItemGroup>
 <ItemGroup><Resource Include="../Syphon.Desktop/Assets/Brand/syphon_emblem_transparent.png" Link="Brand/emblem.png"/><Resource Include="../../design/brand/syphon_wordmark_clean.png" Link="Brand/wordmark.png"/></ItemGroup>
 <ItemGroup Condition="'$(PayloadPath)' != ''"><EmbeddedResource Include="$(PayloadPath)" LogicalName="Syphon.Payload.zip"/></ItemGroup>
</Project>
