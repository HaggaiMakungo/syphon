<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syphon.Desktop">
 <ControlTemplate x:Key="DownloadCardTemplate" TargetType="DataGridRow">
  <Grid Margin="6,8,10,10">
   <Border Background="{StaticResource Card}" CornerRadius="16" Effect="{StaticResource RaisedLight}" IsHitTestVisible="False"/>
   <Border Background="{StaticResource Card}" CornerRadius="16" Effect="{StaticResource RaisedDark}" IsHitTestVisible="False"/>
   <Border x:Name="CardFace" Background="{StaticResource Card}" CornerRadius="16" BorderBrush="Transparent" BorderThickness="1" Padding="20,18">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{Binding StatusBrush}" CornerRadius="2" Height="44" VerticalAlignment="Top"/>
     <Grid Grid.Column="1" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="{StaticResource Inset}" BorderBrush="{StaticResource InsetEdge}" BorderThickness="1" CornerRadius="12" Width="36" Height="40"><TextBlock Text="↓" Foreground="{Binding StatusBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,12,0"><TextBlock Text="{Binding Filename}" ToolTip="{Binding Filename}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Bright}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ConnectionSummary}" FontSize="12" Foreground="{StaticResource Sub}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
       <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding SpeedText}" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource Sub}" HorizontalAlignment="Right" FontSize="11" Margin="0,4,0,0"/></StackPanel>
       <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding PrimaryAction}" IsEnabled="{Binding CanAct}" Command="{x:Static ApplicationCommands.Open}" CommandParameter="{Binding}" Padding="12,9" FontSize="11" AutomationProperties.Name="Pause or resume this download"/><Button Content="×" IsEnabled="{Binding CanPause}" Command="{x:Static ApplicationCommands.Stop}" CommandParameter="{Binding}" Padding="12,9" Margin="0" ToolTip="Cancel download" AutomationProperties.Name="Cancel this download"/></StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Margin="0,18,0,10"><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" IsIndeterminate="{Binding UnknownProgress}" Maximum="100" Foreground="{Binding StatusBrush}" Height="6"/><local:SegmentStrip Snapshot="{Binding Snapshot}" Margin="0,7,0,0"/></StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource Sub}"/><TextBlock Grid.Column="1" Text="{Binding TransferMode}" Foreground="{Binding StatusBrush}" FontSize="12" FontWeight="SemiBold"/></Grid>
     </Grid>
    </Grid>
   </Border>
  </Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CardFace" Property="BorderBrush" Value="{StaticResource Mid}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardFace" Property="BorderBrush" Value="{StaticResource Bright}"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <ControlTemplate x:Key="HistoryCardTemplate" TargetType="DataGridRow">
  <Grid Margin="6,5,10,6"><Border Background="{StaticResource Card}" CornerRadius="12" Effect="{StaticResource RaisedLight}" IsHitTestVisible="False"/><Border Background="{StaticResource Card}" CornerRadius="12" Effect="{StaticResource RaisedDark}" IsHitTestVisible="False"/><Border x:Name="HistoryFace" Background="{StaticResource Card}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1" Padding="6,12"><DataGridCellsPresenter/></Border></Grid>
  <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryFace" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers>
 </ControlTemplate>
 <Style x:Key="TaskCardRow" TargetType="DataGridRow"><Setter Property="Template" Value="{StaticResource DownloadCardTemplate}"/><Setter Property="Background" Value="Transparent"/><Setter Property="MinHeight" Value="128"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="History"><Setter Property="Template" Value="{StaticResource HistoryCardTemplate}"/><Setter Property="MinHeight" Value="76"/></DataTrigger></Style.Triggers></Style>
</ResourceDictionary>
