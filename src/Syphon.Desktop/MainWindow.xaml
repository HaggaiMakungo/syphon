<Window x:Class="Syphon.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Syphon.Desktop"
 Title="Syphon" Icon="{StaticResource SyphonWindowIcon}" Width="1200" Height="850" MinWidth="1040" MinHeight="760" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" Closing="Window_Closing">
 <Window.CommandBindings><CommandBinding Command="ApplicationCommands.Open" CanExecute="CardAction_CanExecute" Executed="CardAction_Executed"/><CommandBinding Command="ApplicationCommands.Stop" CanExecute="CardAction_CanExecute" Executed="CardAction_Executed"/></Window.CommandBindings>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="16,24">
    <StackPanel DockPanel.Dock="Top">
     <Image Source="{StaticResource SyphonMark}" Width="36" Height="46" Margin="0,0,0,20"/>
     <Button x:Name="DownloadsNav" Content="↓" Style="{StaticResource NavButton}" Background="{StaticResource Inset}" ToolTip="Downloads" AutomationProperties.Name="Downloads" Click="DownloadsNav_Click"/>
     <Button x:Name="HistoryNav" Content="◷" Style="{StaticResource NavButton}" ToolTip="History" AutomationProperties.Name="History" Click="HistoryNav_Click"/>
    </StackPanel>
    <Button x:Name="SettingsNav" DockPanel.Dock="Bottom" Content="⚙" Style="{StaticResource NavButton}" ToolTip="Settings" AutomationProperties.Name="Settings" Click="SettingsNav_Click" VerticalAlignment="Bottom"/>
    <Border/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><TextBlock Text="SYPHON" FontSize="10" Foreground="{StaticResource Sub}"/><TextBlock x:Name="PageTitle" Text="Downloads" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Bright}"/></StackPanel>
     <TextBox x:Name="SearchBox" Tag="Search files…" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" TextChanged="Search_Changed" ToolTip="Search filenames or sites" AutomationProperties.Name="Search filenames or sites"/>
     <ComboBox x:Name="FileTypeFilter" Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="File type filter"><ComboBoxItem Content="All types"/><ComboBoxItem Content="Video"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Documents"/><ComboBoxItem Content="Archives"/><ComboBoxItem Content="Other"/></ComboBox>
     <Button x:Name="NewDownloadButton" Grid.Column="3" Content="＋ New download" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="0" Click="NewDownload_Click"/>
    </Grid>
   </Border>
   <Grid x:Name="DownloadsView" Grid.Row="1" Margin="24,0,24,16">
    <Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><Grid x:Name="TransferStats" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Total speed" FontSize="11" Foreground="{StaticResource Sub}"/><TextBlock x:Name="TotalSpeedText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Bright}"/></StackPanel>
<StackPanel Grid.Column="1"><TextBlock Text="Queue" FontSize="11" Foreground="{StaticResource Sub}"/><TextBlock x:Name="QueueCountText" Text="0 active" FontSize="17" Margin="0,4,0,0"/></StackPanel>
<StackPanel Grid.Column="2"><TextBlock Text="Saved" FontSize="11" Foreground="{StaticResource Sub}"/><TextBlock x:Name="SavedSizeText" Text="0 B" FontSize="21" FontWeight="SemiBold"/></StackPanel>
<StackPanel Grid.Column="3"><TextBlock Text="Connections" FontSize="11" Foreground="{StaticResource Sub}"/><TextBlock x:Name="ConnectionCountText" Text="0" FontSize="21" FontWeight="SemiBold"/></StackPanel></Grid>
<TextBlock x:Name="SummaryText" Text="No downloads yet" FontSize="11" Foreground="{StaticResource Sub}"/></StackPanel><Button x:Name="FloatingWindowButton" Grid.Column="1" Content="Floating window" Background="{StaticResource Surface}" VerticalAlignment="Center" Margin="0" Click="Floating_Click"/></Grid>
    <Expander x:Name="QuickAddExpander" Grid.Row="1" Header="Quick add a link" Foreground="{StaticResource Sub}" Margin="0,0,0,16">
     <Border Background="{StaticResource Card}" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,10,0,0"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Label Target="{Binding ElementName=UrlBox}" Content="Download _link" Padding="0,0,0,5"/>
      <TextBox x:Name="UrlBox" Grid.Row="1" Grid.ColumnSpan="2" AutomationProperties.Name="Download link"/>
      <Label Grid.Row="2" Target="{Binding ElementName=DestinationBox}" Content="Save _to" Padding="0,8,0,5"/>
      <TextBox x:Name="DestinationBox" Grid.Row="3" AutomationProperties.Name="Destination file"/>
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><Button Content="Browse…" Click="Browse_Click"/><Button x:Name="DownloadButton" Content="Download" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Download_Click" Margin="0"/></StackPanel>
      <CheckBox x:Name="SingleConnectionChoice" Grid.Row="4" Grid.ColumnSpan="2" Content="Single connection" Margin="0,10,0,0" AutomationProperties.Name="Use a single connection"/>
     </Grid></Border>
    </Expander>
    <Border Grid.Row="2" Background="Transparent">
     <DataGrid x:Name="TaskList" Tag="Downloads" RowStyle="{StaticResource TaskCardRow}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" HeadersVisibility="None" GridLinesVisibility="None" SelectionChanged="TaskList_SelectionChanged" AutomationProperties.Name="Downloads" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Resources>
       <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Margin" Value="10,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
       <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Sub}"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FontSize" Value="11"/></Style>
       <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger></Style.Triggers></Style>
       <Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/></Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="Name" Width="*" MinWidth="220" SortMemberPath="Filename"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Filename}" Foreground="{StaticResource Bright}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Host}" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="115" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn x:Name="ProgressColumn" Header="Progress" Binding="{Binding ProgressText}" Width="180" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="95" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn x:Name="TimeColumn" Header="Remaining" Binding="{Binding RemainingText}" Width="105" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn x:Name="ConnectionsColumn" Header="Connections" Binding="{Binding ConnectionsText}" Width="90" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn x:Name="HistorySizeColumn" Header="Size" Binding="{Binding SizeText}" Width="95" Visibility="Collapsed" ElementStyle="{StaticResource CellText}"/>
       <DataGridTextColumn x:Name="HistoryHashColumn" Header="SHA-256" Binding="{Binding DigestText}" Width="95" Visibility="Collapsed" ElementStyle="{StaticResource CellText}"/>
      </DataGrid.Columns>
     </DataGrid>
    </Border>
    <WrapPanel Grid.Row="3" Margin="0,14,0,12"><Button x:Name="PauseButton" Content="Pause" IsEnabled="False" Click="Pause_Click"/><Button x:Name="ResumeButton" Content="Resume" IsEnabled="False" Click="Resume_Click"/><Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/><Button x:Name="RestartButton" Content="Restart fresh…" IsEnabled="False" Click="Restart_Click"/><Button x:Name="OpenFolderButton" Content="Open folder" IsEnabled="False" Click="OpenFolder_Click"/><Button x:Name="RemoveButton" Content="Remove…" IsEnabled="False" Click="Remove_Click"/></WrapPanel>
    <StackPanel Grid.Row="4" MinHeight="104"><Border x:Name="ManagerChartPanel" Background="{StaticResource Inset}" CornerRadius="12" Padding="12,8" Margin="0,0,0,12"><StackPanel><TextBlock Text="TRANSFER SPEED · ALL DOWNLOADS" FontSize="10" Foreground="{StaticResource Sub}" Margin="4,0,0,6"/><local:RechartsSpeedChart x:Name="ManagerSpeedChart" Height="66"/></StackPanel></Border><ProgressBar x:Name="TransferBar" Height="4" Maximum="100" AutomationProperties.Name="Selected download progress"/><TextBlock x:Name="StatusText" Text="Checking saved downloads…" Margin="0,10,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="DetailText" Foreground="{StaticResource Sub}" Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap"/><Expander x:Name="DiagnosticExpander" Header="Technical details" Foreground="{StaticResource Sub}" Margin="0,6,0,0" Visibility="Collapsed"><TextBlock x:Name="DiagnosticText" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{StaticResource Sub}"/></Expander></StackPanel>
   </Grid>
   <ContentControl x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</Window>
